expression(library(data.table), readDiana <- function(root) {
    Layout <- jsonlite::fromJSON(file.path(root, "_local/hazard.diana.json"), 
        simplifyVector = FALSE)
    UHS <- readRDS(file.path(root, "data/hazard/tables/UHSTable.Rds"))[ID == 
        "M2V4D" & siteID == "CFD" & Vs30 %in% unlist(Layout$vs30)]
    UHS[, `:=`(p, fifelse(p == "mean", "mean", as.character(as.numeric(p))))]
    Keys <- c("Vs30", "TR", "Tn", "p")
    stopifnot(!anyDuplicated(UHS, by = Keys), all(is.finite(UHS$SaF)), 
        all(UHS$SaF > 0))
    stopifnot(setequal(unique(UHS$Vs30), unlist(Layout$vs30)))
    Periods <- sort(unique(UHS$Tn))
    stopifnot(nrow(UHS) == length(Layout$vs30) * uniqueN(UHS$TR) * 
        length(Periods) * uniqueN(UHS$p))
    NRC <- jsonlite::fromJSON(file.path(root, "dev/SoT/m65-20261014/diana-hazard/nrc2020-response.json"))
    stopifnot(is.null(NRC$errors))
    NRC <- rbindlist(NRC$data$NBC2020[setdiff(names(NRC$data$NBC2020), 
        "metadata")])
    NRC[, `:=`(Vs30, vapply(vs30, function(x) x[[1]], numeric(1)))]
    NRC[, `:=`(TR, c(2500, 1000, 500)[match(poe50, c(2, 5, 10))])]
    NRC <- melt(NRC, id.vars = c("Vs30", "TR", "poe50", "foe"), 
        measure.vars = c("pga", "sa0p05", "sa0p1", "sa0p2", "sa0p3", 
            "sa0p5", "sa1p0", "sa2p0", "sa5p0"), variable.name = "imt", 
        value.name = "SaF")
    NRC[, `:=`(Tn, c(0, 0.05, 0.1, 0.2, 0.3, 0.5, 1, 2, 5)[match(imt, 
        c("pga", "sa0p05", "sa0p1", "sa0p2", "sa0p3", "sa0p5", 
            "sa1p0", "sa2p0", "sa5p0"))])]
    stopifnot(!anyNA(NRC[, .(Vs30, TR, Tn, SaF)]), !anyDuplicated(NRC, 
        by = c("Vs30", "TR", "Tn")))
    RMw <- readRDS(file.path(root, "data/hazard/tables/RMwTable.Rds"))[ID == 
        "M2V4D" & siteID == "CFD" & Tn == 0 & TR %in% unlist(Layout$tr)]
    list(layout = Layout, uhs = UHS, nrc = NRC, rmw = RMw, periods = Periods)
}, dianaTable <- function(data, item) {
    DT <- data$uhs[p == item$stat & TR %in% unlist(data$layout$tr)]
    if (item$kind == "pga") {
        DT <- DT[Tn == 0, .(Row = TR, Vs30, SaF)]
        DT <- dcast(DT, Row ~ Vs30, value.var = "SaF")
        DT[, `:=`(Row, unlist(data$layout$trLabel)[match(Row, 
            unlist(data$layout$tr))])]
        DT[, `:=`((as.character(unlist(data$layout$vs30))), lapply(.SD, 
            function(x) formatC(x, format = "f", digits = 4))), 
            .SDcols = as.character(unlist(data$layout$vs30))]
    }
    if (item$kind == "spectra") {
        DT <- DT[TR == item$tr, .(Row = Tn, Vs30, SaF)]
        DT <- dcast(DT, Row ~ Vs30, value.var = "SaF")
        DT[, `:=`(Row, formatC(Row, format = "f", digits = 3))]
        DT[, `:=`((as.character(unlist(data$layout$vs30))), lapply(.SD, 
            function(x) formatC(x, format = "f", digits = 3))), 
            .SDcols = as.character(unlist(data$layout$vs30))]
    }
    stopifnot(item$kind %in% c("pga", "spectra"), !anyNA(DT))
    setcolorder(DT, c("Row", as.character(unlist(data$layout$vs30))))
    DT
}, dianaPlot <- function(data, item) {
    if (item$kind == "rmw") {
        DT <- dcast(data$rmw[TR == item$tr], Mw ~ R, value.var = "p")
        Z <- as.matrix(DT[, -"Mw"])
        par(mar = c(1, 1, 3, 1))
        persp(x = DT$Mw, y = as.numeric(names(DT)[-1]), z = Z * 
            100, theta = -35, phi = 25, expand = 1.2, col = "#2c7fb8", 
            shade = 0.4, border = "#2b4b65", xlab = "Magnitude Mw", 
            ylab = "Distance R (km)", zlab = "Contribution (%)", 
            ticktype = "detailed", nticks = 4, main = paste0("PGA | TR = ", 
                format(item$tr, big.mark = ","), " years"), cex.main = 0.8, 
            cex.axis = 0.65, cex.lab = 0.8)
        return(invisible(NULL))
    }
    DT <- data$uhs[p == item$stat]
    if (item$kind %in% c("uhs", "nrc")) {
        DT <- DT[Vs30 == item$vs30 & TR %in% unlist(data$layout$tr)]
        if (item$kind == "nrc") 
            DT <- DT[TR %in% c(500, 1000, 2500)]
        DT[, `:=`(Series, factor(TR, levels = unlist(data$layout$tr)))]
        PLOT <- ggplot2::ggplot(DT, ggplot2::aes(x = Tn, y = SaF, 
            colour = Series)) + ggplot2::geom_line(linewidth = 0.55) + 
            ggplot2::labs(x = "Spectral period (s)", y = "Spectral acceleration (g)", 
                colour = "Return period (years)")
        if (item$kind == "nrc") {
            NRC <- data$nrc[Vs30 == item$vs30]
            NRC[, `:=`(Series, factor(TR, levels = unlist(data$layout$tr)))]
            PLOT <- PLOT + ggplot2::geom_point(data = NRC, shape = 0, 
                size = 2.1, stroke = 0.6) + ggplot2::labs(subtitle = "Lines: project model | Squares: NRC 2020")
        }
    }
    if (item$kind == "design") {
        DT <- DT[TR == item$tr]
        DT[, `:=`(Series, factor(Vs30, levels = unlist(data$layout$vs30)))]
        PLOT <- ggplot2::ggplot(DT, ggplot2::aes(x = Tn, y = SaF, 
            colour = Series)) + ggplot2::geom_line(linewidth = 0.55) + 
            ggplot2::labs(x = "Spectral period (s)", y = "Spectral acceleration (g)", 
                colour = "Vs30 (m/s)")
    }
    if (item$kind == "aep") 
        stop("AEP presentation awaits owner decision")
    stopifnot(item$kind %in% c("uhs", "nrc", "design"))
    PLOT + ggplot2::theme_bw(base_size = 10) + ggplot2::theme(legend.position = "bottom", 
        legend.key.width = grid::unit(1.1, "cm"), panel.grid.minor = ggplot2::element_blank(), 
        plot.margin = ggplot2::margin(5, 8, 5, 5)) + ggplot2::guides(colour = ggplot2::guide_legend(nrow = 1)) + 
        ggplot2::scale_colour_brewer(palette = "Dark2")
})
